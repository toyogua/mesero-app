APP_NAME=mesero-app
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Guatemala

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_GT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# DATABASE
# Local (Docker): MySQL via docker-compose
# Shared (DreamHost): MySQL provisto por el hosting
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mesero_app
DB_USERNAME=mesero
DB_PASSWORD=secret

# -----------------------------------------------------------------------------
# SESSION / CACHE / QUEUE
# Local (Docker): redis
# Shared (DreamHost): database (no Redis disponible)
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# REDIS (solo local/on-premise Docker)
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# BROADCASTING — DUAL MODE
# Local/Docker: reverb (self-hosted)
# Producción shared: ably (SaaS)
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

# Reverb (local/Docker)
REVERB_APP_ID=mesero-app
REVERB_APP_KEY=mesero-local-key
REVERB_APP_SECRET=mesero-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_BROADCAST_CONNECTION="${BROADCAST_CONNECTION}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Ably (producción shared) — completar al desplegar
ABLY_KEY=
VITE_ABLY_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# MAIL
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# FEL Guatemala (SAT) — completar al integrar certificador
# Certificadores comunes: Infile, G&T, Megaprint, Mercom
# -----------------------------------------------------------------------------
FEL_CERTIFIER=
FEL_USERNAME=
FEL_PASSWORD=
FEL_NIT_EMISOR=
FEL_ESTABLECIMIENTO=

VITE_APP_NAME="${APP_NAME}"
